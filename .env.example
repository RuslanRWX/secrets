# Encrypts every secret in the database. Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without this key the stored secrets cannot be read.
MASTER_KEY=

# Signs session tokens. Generate the same way. Rotating it signs everyone out.
JWT_SECRET=

# PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=change-me

# Host ports.
UI_PORT=8088
API_PORT=8080
